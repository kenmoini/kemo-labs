##########################################################################################
### Networks #############################################################################
##########################################################################################

# FileName=paperless
[Network]
NetworkName=paperless
InterfaceName=paperless
Options=com.docker.network.bridge.name=paperless
Subnet=10.10.6.0/24
Gateway=10.10.6.1
Internal=false
IPv6=false
DisableDNS=false
NetworkDeleteOnStop=false
Options=isolate=false
Options=no_default_route=1

##########################################################################################
### Images ###############################################################################
##########################################################################################
---
# FileName=caas-paperless-ngx
[Image]
Image=ghcr.io/paperless-ngx/paperless-ngx:2.20.15
AllTags=false
Policy=newer

---
# FileName=caas-gotenberg
[Image]
Image=docker.io/gotenberg/gotenberg:8.33.0
AllTags=false
Policy=newer

---
# FileName=caas-tika
[Image]
Image=docker.io/apache/tika:3.3.1.0-full
AllTags=false
Policy=newer

---
# FileName=caas-util-redis
[Image]
Image=docker.io/library/redis:8
AllTags=false
Policy=newer

##########################################################################################
### Volumes ##############################################################################
##########################################################################################
---
# FileName=paperless-redis-data
[Volume]
VolumeName=paperless-redis-data

##########################################################################################
### Pod ##################################################################################
##########################################################################################
---
# FileName=caas-paperless
[Pod]
PodName=paperless

##########################################################################################
### Containers ###########################################################################
##########################################################################################
---
# FileName=caas-paperless-redis
[Service]
Restart=always

[Install]
WantedBy=multi-user.target

[Unit]
After=caas-pdns-auth.container
Requires=paperless-network.service
Description=Redis for Paperless NGX

[Container]
Pod=caas-paperless.pod
Image=caas-util-redis.image
ContainerName=paperless-redis

EnvironmentFile=/opt/workdir/kemo-labs/documentation/paperless/.env
Network=paperless.network
Volume=paperless-redis-data.volume:/data

HealthCmd=redis-cli ping || exit 1
HealthStartupCmd=redis-cli ping || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

Label="homepage.group=Paperless"
Label="homepage.name=Redis"
Label="homepage.icon=redis.png"
Label="homepage.description=Redis Cache for Paperless"

---
# FileName=caas-paperless-tika
[Service]
Restart=always

[Install]
WantedBy=multi-user.target

[Unit]
After=caas-pdns-auth.container
Requires=paperless-network.service
Description=Apache Tika for Paperless NGX

[Container]
Pod=caas-paperless.pod
Image=caas-tika.image
ContainerName=paperless-tika

EnvironmentFile=/opt/workdir/kemo-labs/documentation/paperless/.env
Network=paperless.network

HealthCmd=wget --spider -q http://localhost:9998/tika || exit 1
HealthStartupCmd=wget --spider -q http://localhost:9998/tika || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

Label="homepage.group=Paperless"
Label="homepage.name=Tika"
Label="homepage.icon=tika.png"
Label="homepage.description=Apache Tika for Paperless"

---
# FileName=caas-paperless-gotenberg
[Service]
Restart=always

[Install]
WantedBy=multi-user.target

[Unit]
After=caas-pdns-auth.container
Requires=paperless-network.service
Description=Document Converter for Paperless NGX

[Container]
Pod=caas-paperless.pod
Image=caas-gotenberg.image
ContainerName=paperless-gotenberg
Exec=gotenberg --chromium-disable-javascript=true --chromium-allow-list=file:///tmp/.*

Network=paperless.network

HealthCmd=curl --fail localhost:3000/health | grep '\"status\":\"up\",\"details\"'
HealthStartupCmd=curl --fail localhost:3000/health | grep '\"status\":\"up\",\"details\"'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

Label="homepage.group=Paperless"
Label="homepage.name=Gotenberg"
Label="homepage.icon=gotenberg.png"
Label="homepage.description=Gotenberg for Paperless"

---
# FileName=caas-paperless-server
[Service]
Restart=always

[Install]
WantedBy=multi-user.target

[Unit]
After=caas-pdns-auth.container
After=caas-paperless-gotenberg.container
After=caas-paperless-tika.container
After=caas-paperless-redis.container
Requires=paperless-network.service
Requires=internal-db-network.service
Requires=traefik-network.service
Description=Paperless NGX Document Management
ConditionPathExists=/opt/workdir/kemo-labs/documentation/paperless/.env

[Container]
Pod=caas-paperless.pod
Image=caas-paperless-ngx.image
ContainerName=paperless-server

EnvironmentFile=/opt/workdir/kemo-labs/documentation/paperless/.env

Network=traefik.network
Network=internal-db.network
Network=paperless.network

Volume=/opt/workdir/caas/paperless-ngx/data:/usr/src/paperless/data
Volume=/opt/workdir/caas/paperless-ngx/media:/usr/src/paperless/media
Volume=/opt/workdir/caas/paperless-ngx/export:/usr/src/paperless/export
Volume=/opt/workdir/caas/dropbox/data/paperless-uploads:/usr/src/paperless/consume

HealthCmd=curl -fsS --max-time 2 http://localhost:8000
HealthStartupCmd=curl -fsS --max-time 2 http://localhost:8000
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

Label="homepage.group=Paperless"
Label="homepage.name=Paperless NGX"
Label="homepage.icon=paperless.png"
Label="homepage.description=Document Management System"
Label="homepage.href=https://paperless.apps.lab.kemo.dev"

Label="traefik.enable=true"
Label="traefik.docker.network=traefik"
Label="traefik.http.routers.paperless.rule=Host(`paperless.apps.lab.kemo.dev`)"
Label="traefik.http.routers.paperless.tls=true"
Label="traefik.http.routers.paperless.tls.certresolver=stepca"
Label="traefik.http.routers.paperless.service=paperless"
Label="traefik.http.services.paperless.loadbalancer.server.port=8000"

