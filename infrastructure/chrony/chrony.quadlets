# FileName=caas-chrony
[Image]
Image=ghcr.io/kenmoini/docker-chrony:latest
AllTags=false
Policy=newer
---
# FileName=caas-chrony
[Install]
WantedBy=multi-user.target

[Unit]
After=network-online.target
Description=Chrony time sync

[Container]
Image=caas-chrony.image
ContainerName=chrony

Network=bridge42
IP=192.168.42.16
PublishPort=123:123

Label="homepage.group=Utilities"
Label="homepage.name=Chrony Time Sync"
Label="homepage.icon=mdi-clock-digital"
Label="homepage.description=Chrony Time Synchronization Service"
Label="dockns.powerdns.record=A"
Label="dockns.powerdns.name=time.lab.kemo.dev"
Label="dockns.powerdns.ttl=60"
Label="dockns.powerdns.ip=192.168.42.16"

AddCapability=SYS_NICE
AddCapability=SYS_RESOURCE
AddCapability=SYS_TIME
NoNewPrivileges=true
Device=/dev/rtc0

HealthCmd=chronyc tracking > /dev/null 2>&1 || exit 1
HealthStartupCmd=chronyc tracking > /dev/null 2>&1 || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s