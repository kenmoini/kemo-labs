##########################################################################################
### Images ###############################################################################
##########################################################################################

# FileName=caas-iperf3
[Image]
Image=docker.io/networkstatic/iperf3:latest
AllTags=false
Policy=newer

---
# FileName=caas-openspeedtest
[Image]
Image=docker.io/openspeedtest/latest:latest
AllTags=false
Policy=newer

##########################################################################################
### Containers ###########################################################################
##########################################################################################
---
# FileName=caas-iperf3
[Service]
Restart=always

[Install]
WantedBy=multi-user.target

[Unit]
After=network-online.target
Description=iPerf3 Network Performance Testing

[Container]
Image=caas-iperf3.image
ContainerName=iperf3
Exec="-s"

Network=bridge42
IP=192.168.42.13

Label="homepage.group=Utilities"
Label="homepage.name=iperf3"
Label="homepage.icon=/assets/iperf3-logo.png"
Label="homepage.description=iperf3 on port 5201"

HealthCmd="ls /proc/1/status > /dev/null 2>&1"
HealthStartupCmd="ls /proc/1/status > /dev/null 2>&1"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

---
# FileName=caas-openspeedtest
[Service]
Restart=always

[Install]
WantedBy=multi-user.target

[Unit]
After=caas-pdns-recursor.container
Requires=traefik-network.service
Description=OpenSpeedTest Network Performance Testing

[Container]
Image=caas-openspeedtest.image
ContainerName=openspeedtest
Environment=ENABLE_LETSENCRYPT=false

Network=traefik.network

Label="traefik.enable=true"
Label="traefik.docker.network=traefik"
Label="traefik.http.routers.speedtest.rule=Host(`speedtest.apps.lab.kemo.dev`)"
Label="traefik.http.routers.speedtest.entrypoints=websecure"
Label="traefik.http.routers.speedtest.tls=true"
Label="traefik.http.routers.speedtest.tls.certresolver=stepca"
Label="traefik.http.routers.speedtest.service=speedtest"
Label="traefik.http.services.speedtest.loadbalancer.server.port=3000"
Label="traefik.http.middlewares.speedtest-buffering.buffering.maxRequestBodyBytes=50000000"
Label="traefik.http.middlewares.speedtest-buffering.buffering.memRequestBodyBytes=50000000"
Label="traefik.http.routers.speedtest.middlewares=speedtest-buffering,authentik-auth@file"
Label="homepage.group=Utilities"
Label="homepage.name=Open Speedtest"
Label="homepage.icon=openspeedtest.png"
Label="homepage.description=Open Speedtest"
Label="homepage.href=https://speedtest.apps.lab.kemo.dev"

HealthCmd="curl -sf http://127.0.0.1:3000/ > /dev/null || exit 1"
HealthStartupCmd="curl -sf http://127.0.0.1:3000/ > /dev/null || exit 1"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s