# Uptime Kuma - Environment Variables
UPTIME_KUMA_IN_CONTAINER=1
UPTIME_KUMA_PORT=3001

# Allow embedding in iframes (for Grafana dashboards)
UPTIME_KUMA_DISABLE_FRAME_SAMEORIGIN=true
UPTIME_KUMA_DB_TYPE=mariadb
UPTIME_KUMA_DB_HOSTNAME=shared-mariadb
UPTIME_KUMA_DB_PORT=3306
UPTIME_KUMA_DB_NAME=uptime_kuma
UPTIME_KUMA_DB_USERNAME=uptime_kuma
UPTIME_KUMA_DB_PASSWORD=changeme-set-db-password