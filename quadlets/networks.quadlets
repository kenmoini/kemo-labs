# FileName=podman-proxy
[Network]
NetworkName=podman-proxy
InterfaceName=podman-proxy
Options=com.docker.network.bridge.name=podman-proxy
Subnet=10.10.0.0/24
Gateway=10.10.0.1
Internal=false
IPv6=false
DisableDNS=false
NetworkDeleteOnStop=false
Options=isolate=false
Options=no_default_route=1

