##########################################################################################
### Images ###############################################################################
##########################################################################################

# FileName=caas-dockns
[Image]
Image=docker.io/brenekh/dockns:0.5.0
AllTags=false
Policy=newer

##########################################################################################
### Containers ###########################################################################
##########################################################################################
---
# FileName=caas-dockns
[Service]
Restart=always

[Install]
WantedBy=multi-user.target

[Unit]
After=caas-pdns-auth.container
Requires=internal-dns-network.service
Requires=podman-proxy-network.service
Description=DockNS Record Orchestration
ConditionPathExists=/opt/workdir/kemo-labs/utilities/dockns/.env

[Container]
ContainerName=dockns
Image=caas-dockns.image

EnvironmentFile=/opt/workdir/kemo-labs/utilities/dockns/.env
Environment=DOCKER_HOST=tcp://podman-proxy:2375

HostName=dockns
Network=podman-proxy.network
Network=internal-dns.network

Label=homepage.group=Utilities
Label=homepage.name=DockNS
Label=homepage.icon=mdi-anchor
Label="homepage.description=DockNS Record Orchestration"

Volume=dockns-data.volume:/data:Z

##########################################################################################
### Volumes ##############################################################################
##########################################################################################
---
# FileName=dockns-data
[Volume]
VolumeName=dockns-data