OTEL_SERVICE_NAME=podman-proxy
LOG_LEVEL=warning
### Granted by Default
EVENTS=1
PING=1
VERSION=1
### Security critical
AUTH=0
SECRETS=0
EXEC=0
POST=0 # Makes everything read only
PLUGINS=0
ALLOW_START=0
ALLOW_STOP=0
ALLOW_PAUSE=0
ALLOW_UNPAUSE=0
ALLOW_RESTART=0
### Not Needed
SWARM=0
BUILD=0
COMMIT=0
CONFIGS=0
TASKS=0
### General
CONTAINERS=1
SERVICES=1
DISTRIBUTION=1
STATS=1
GRPC=1
IMAGES=1
INFO=1
NETWORKS=1
NODES=1
VOLUMES=1
SESSION=1
SYSTEM=1